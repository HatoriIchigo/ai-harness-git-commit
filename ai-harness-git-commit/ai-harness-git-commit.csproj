<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ai_harness_git_commit</RootNamespace>
    <AssemblyName>ai-harness-git-commit</AssemblyName>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0</InformationalVersion>
    <!-- baselib はホスト(ai-harness-main)が共有ロードするため、出力にコピーしない。 -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ai-harness-baselib\ai-harness-baselib\ai-harness-baselib.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- .claude/rules へ配布する rule（CopyRule）と、有効化時に無ければ置くデフォルト設定（CopyDefaultConfig）。 -->
  <ItemGroup>
    <EmbeddedResource Include="../resources/rules/git-commit.rule.md">
      <LogicalName>rules/git-commit.rule.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="git-commit.config.yml" />
  </ItemGroup>

</Project>
